# Sandbox only. Copy to .env.docker and use unique local values.
ENV=local
POSTGRES_DB=ccf_db
POSTGRES_USER=ccf_app
POSTGRES_PASSWORD=change-this-sandbox-password
SECRET_KEY=change-this-sandbox-secret-key
ENCRYPTION_KEY=change-this-sandbox-encryption-key
STUB_COMMS=true
NEXT_PUBLIC_API_URL=http://localhost:18001/api
FRONTEND_URL=http://localhost:13001
