#!/usr/bin/env bash
# Pre-push hook: validaciones de seguridad antes de enviar a producción
# Si cualquier validación crítica falla, el push se bloquea.
set -euo pipefail

PUSH_REMOTE="${1:-origin}"

REPO_ROOT="$(git rev-parse --show-toplevel)"
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'
if [ -x "$REPO_ROOT/venv/bin/python" ]; then
    VENV="$REPO_ROOT/venv/bin"
elif [ -x "/root/ccf/venv/bin/python" ]; then
    # Los worktrees normalmente comparten el entorno virtual principal.
    VENV="/root/ccf/venv/bin"
else
    echo -e "${RED}✗ No se encontró el entorno virtual de Python${NC}"
    exit 2
fi
MODE="${CCF_PRE_PUSH_MODE:-fast}"
DEPLOY_AFTER_VALIDATION="${CCF_PRE_PUSH_DEPLOY:-0}"
RUN_FRONTEND_E2E="${CCF_PRE_PUSH_E2E:-0}"
QUALITY_TIMEOUT_SECONDS="${CCF_PRE_PUSH_CHECK_TIMEOUT:-300}"
HEAD_REF="${CCF_PRE_PUSH_HEAD:-HEAD}"

FAIL=0

# Git supplies one line per ref being pushed on stdin.  Read it before any
# quality work so the hook can derive the real target branch and remote base.
# This prevents validating Academy against origin/main or pushing from the
# wrong worktree by accident.
PUSH_INPUT="$(cat)"
PUSH_COUNT=0
PUSH_BRANCH=""
PUSH_LOCAL_REF=""
PUSH_LOCAL_SHA=""
PUSH_REMOTE_REF=""
PUSH_REMOTE_SHA=""
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_ref:-}" ] || continue
    PUSH_COUNT=$((PUSH_COUNT + 1))
    PUSH_LOCAL_REF="$local_ref"
    PUSH_LOCAL_SHA="$local_sha"
    PUSH_REMOTE_REF="$remote_ref"
    PUSH_REMOTE_SHA="$remote_sha"
done <<< "$PUSH_INPUT"

# When the hook is invoked directly for a local quality rehearsal there is no
# Git stdin payload.  Reconstruct the single current-branch push metadata so
# the same branch contract is exercised without weakening real git pushes.
if [ -z "$PUSH_INPUT" ]; then
    CURRENT_BRANCH="$(git symbolic-ref --quiet --short HEAD || true)"
    if [ -z "$CURRENT_BRANCH" ]; then
        echo -e "${RED}✗ No se puede validar una rama detached.${NC}"
        exit 2
    fi
    PUSH_LOCAL_REF="refs/heads/$CURRENT_BRANCH"
    PUSH_LOCAL_SHA="$(git rev-parse HEAD)"
    PUSH_REMOTE_REF="refs/heads/$CURRENT_BRANCH"
    PUSH_REMOTE_SHA="$(git rev-parse "origin/$CURRENT_BRANCH" 2>/dev/null || printf '%040d' 0)"
    PUSH_COUNT=1
fi

if [ "$PUSH_COUNT" -ne 1 ] || [[ "$PUSH_REMOTE_REF" != refs/heads/* ]]; then
    echo -e "${RED}✗ Push ambiguo: solo se permite una rama local hacia una rama remota.${NC}"
    echo "  Usa: scripts/push_branch.sh <rama>"
    exit 2
fi

PUSH_BRANCH="${PUSH_REMOTE_REF#refs/heads/}"
ZERO_SHA="0000000000000000000000000000000000000000"
CURRENT_BRANCH="$(git symbolic-ref --quiet --short HEAD || true)"
if [ "$PUSH_BRANCH" = "main" ] && [ "${CCF_ALLOW_MAIN_PUSH:-0}" != "1" ]; then
    echo -e "${RED}✗ Push directo a main bloqueado; integra mediante una rama temporal revisada.${NC}"
    exit 2
fi
if [[ "$PUSH_BRANCH" != archive/merged/* && "$PUSH_BRANCH" != archive/stale/* ]] && [ "$PUSH_LOCAL_SHA" = "$ZERO_SHA" ]; then
    : # Deletion is validated below by the immutable archive ref.
elif [[ "$PUSH_BRANCH" != archive/merged/* && "$PUSH_BRANCH" != archive/stale/* ]] && [ "$CURRENT_BRANCH" != "$PUSH_BRANCH" ]; then
    echo -e "${RED}✗ Worktree incorrecto.${NC}"
    echo "  Rama activa: ${CURRENT_BRANCH:-detached}"
    echo "  Rama destino: $PUSH_BRANCH"
    echo "  Cambia al worktree de la rama destino antes de hacer push."
    exit 2
fi

# Archive refs are immutable evidence. They may only be created at the exact
# source SHA and source deletion is allowed only after the archive exists.
if [[ "$PUSH_BRANCH" == archive/merged/* || "$PUSH_BRANCH" == archive/stale/* ]]; then
    if [ "$PUSH_LOCAL_SHA" = "$ZERO_SHA" ]; then
        echo -e "${RED}✗ No se eliminan ramas archivadas.${NC}"
        exit 2
    fi
    if [ "$PUSH_REMOTE_SHA" != "$ZERO_SHA" ]; then
        echo -e "${RED}✗ El archivo remoto ya existe; no se sobrescribe: $PUSH_BRANCH.${NC}"
        exit 2
    fi
    if ! git rev-parse "origin/main^{commit}" >/dev/null 2>&1; then
        echo -e "${RED}✗ Falta origin/main para validar el archivo.${NC}"
        exit 2
    fi
    if [[ "$PUSH_BRANCH" == archive/merged/* ]] && ! git merge-base --is-ancestor "$PUSH_LOCAL_SHA" "origin/main"; then
        echo -e "${RED}✗ Solo se archivan como merged los SHAs ya integrados en origin/main.${NC}"
        exit 2
    fi
    echo -e "${GREEN}✓ Archivo nuevo validado: $PUSH_BRANCH -> $PUSH_LOCAL_SHA.${NC}"
    exit 0
fi

# Deleting a branch is allowed only after its normalized archive ref exists.
if [ "$PUSH_LOCAL_SHA" = "$ZERO_SHA" ]; then
    if [[ "$PUSH_BRANCH" == archive/* ]]; then
        echo -e "${RED}✗ No se eliminan ramas de archivo.${NC}"
        exit 2
    fi
    ARCHIVE_BRANCH="archive/merged/${PUSH_BRANCH//\//-}"
    STALE_ARCHIVE_BRANCH="archive/stale/${PUSH_BRANCH//\//-}"
    ARCHIVE_SHA="$(git ls-remote --heads "$PUSH_REMOTE" "refs/heads/$ARCHIVE_BRANCH" | awk 'NR == 1 { print $1 }')"
    if [ -z "$ARCHIVE_SHA" ]; then
        ARCHIVE_BRANCH="$STALE_ARCHIVE_BRANCH"
        ARCHIVE_SHA="$(git ls-remote --heads "$PUSH_REMOTE" "refs/heads/$ARCHIVE_BRANCH" | awk 'NR == 1 { print $1 }')"
    fi
    if [ -z "$ARCHIVE_SHA" ]; then
        echo -e "${RED}✗ Eliminación bloqueada: falta archive/merged o archive/stale para $PUSH_BRANCH.${NC}"
        exit 2
    fi
    if [ "$PUSH_REMOTE_SHA" != "$ZERO_SHA" ] && [ "$ARCHIVE_SHA" != "$PUSH_REMOTE_SHA" ]; then
        echo -e "${RED}✗ Eliminación bloqueada: la rama fuente no coincide con el SHA archivado.${NC}"
        exit 2
    fi
    echo -e "${GREEN}✓ Eliminación validada: $ARCHIVE_BRANCH conserva $ARCHIVE_SHA.${NC}"
    exit 0
fi

if [ -z "${CCF_PRE_PUSH_BASE:-}" ]; then
    BASE_REF="origin/$PUSH_BRANCH"
else
    BASE_REF="$CCF_PRE_PUSH_BASE"
fi

if [ "$PUSH_REMOTE_SHA" != "0000000000000000000000000000000000000000" ]; then
    if ! BASE_SHA="$(git rev-parse "$BASE_REF^{commit}" 2>/dev/null)"; then
        echo -e "${RED}✗ No existe la base local $BASE_REF.${NC}"
        echo "  Ejecuta: git fetch origin $PUSH_BRANCH"
        exit 2
    fi
    if [ "$BASE_SHA" != "$PUSH_REMOTE_SHA" ]; then
        echo -e "${RED}✗ La rama remota avanzó; push rechazado para evitar desorden.${NC}"
        echo "  Base local:  $BASE_SHA"
        echo "  Base remota: $PUSH_REMOTE_SHA"
        echo "  Ejecuta: git fetch origin $PUSH_BRANCH y revisa la rama antes de continuar."
        exit 2
    fi
fi

if [ -z "${CCF_PRE_PUSH_HEAD:-}" ]; then
    HEAD_REF="$PUSH_LOCAL_REF"
fi

echo -e "  ${BLUE}Rama validada:${NC} $PUSH_BRANCH"
echo -e "  ${BLUE}Base remota:${NC} $BASE_REF"

if ! "$VENV/python" "$REPO_ROOT/scripts/check_branch_contract.py" \
    --branch "$PUSH_BRANCH" --base "$BASE_REF" --head "$HEAD_REF"; then
    exit 1
fi

# A network failure can happen after every validation has passed but before
# Git receives the pack. Allow a short, exact retry window for that same
# branch/SHA/base tuple. This is evidence reuse, not a validation bypass: the
# proof is written only after the complete gate succeeds below.
VALIDATION_CACHE_DIR="${CCF_PRE_PUSH_VALIDATION_CACHE_DIR:-/tmp/ccf-pre-push-validations}"
VALIDATION_CACHE_FILE="$VALIDATION_CACHE_DIR/$PUSH_LOCAL_SHA.proof"
if [ "${CCF_PRE_PUSH_REUSE_VALIDATION:-0}" = "1" ] && [ -f "$VALIDATION_CACHE_FILE" ]; then
    read -r CACHED_BRANCH CACHED_SHA CACHED_BASE CACHED_HEAD CACHED_AT < "$VALIDATION_CACHE_FILE" || true
    NOW_EPOCH=$(date +%s)
    if [ "$CACHED_BRANCH" = "$PUSH_BRANCH" ] \
        && [ "$CACHED_SHA" = "$PUSH_LOCAL_SHA" ] \
        && [ "$CACHED_BASE" = "$BASE_REF" ] \
        && [ "$CACHED_HEAD" = "$HEAD_REF" ] \
        && [ "$CACHED_AT" -ge $((NOW_EPOCH - 900)) ] 2>/dev/null; then
        echo -e "${GREEN}✓ Reintento autorizado: evidencia completa vigente para $PUSH_LOCAL_SHA${NC}"
        exit 0
    fi
fi

case "$MODE" in
    fast|full) ;;
    *)
        echo -e "${RED}✗ CCF_PRE_PUSH_MODE inválido: $MODE${NC}"
        echo "  Usa: fast | full"
        exit 2
        ;;
esac

echo ""
echo "🔍 Pre-push: validando cambios antes de enviar a producción..."
echo -e "  ${BLUE}Modo:${NC} $MODE"
echo -e "  ${BLUE}Deploy automático:${NC} $DEPLOY_AFTER_VALIDATION"
echo -e "  ${BLUE}Frontend E2E autenticado:${NC} $RUN_FRONTEND_E2E"
echo -e "  ${BLUE}Timeout por check:${NC} ${QUALITY_TIMEOUT_SECONDS}s"
echo -e "  ${BLUE}Diff base/head:${NC} $BASE_REF...$HEAD_REF"
echo ""

# Archivos modificados respecto a la base configurada
# Only validate files that exist in the pushed snapshot. Deleted paths must not
# be handed to py_compile/Ruff from the dirty working tree.
CHANGED_FILES=$(git diff --diff-filter=ACMRTUXB --name-only "$BASE_REF...$HEAD_REF" 2>/dev/null || true)
PY_FILES=$(printf '%s\n' "$CHANGED_FILES" | grep '\.py$' | while IFS= read -r f; do [ -f "$f" ] && printf '%s\n' "$f"; done || true)
FRONTEND_FILES=$(printf '%s\n' "$CHANGED_FILES" | grep '^frontend/' | while IFS= read -r f; do [ -f "$f" ] && printf '%s\n' "$f"; done || true)
ALEMBIC_FILES=$(printf '%s\n' "$CHANGED_FILES" | grep '^alembic/canonical_versions/.*\.py$' || true)
QUALITY_SELECTOR="$VENV/python $REPO_ROOT/scripts/select_quality_checks.py --base $BASE_REF --head $HEAD_REF"
QUALITY_SUMMARY=$($QUALITY_SELECTOR --summary 2>/dev/null || echo "No quality selector summary available.")
mapfile -t QUALITY_CHECKS < <($QUALITY_SELECTOR 2>/dev/null || true)
mapfile -t QUALITY_EXPLANATIONS < <($QUALITY_SELECTOR --explain 2>/dev/null || true)

run_quality_check() {
    local check_id="$1"
    local label="$2"
    local cmd="$3"
    local log_file="/tmp/ccf-quality-check-${check_id}.log"
    local started_at=$SECONDS
    local rc=0
    echo "      - $label (máximo ${QUALITY_TIMEOUT_SECONDS}s)"
    : > "$log_file"
    timeout --kill-after=10s "${QUALITY_TIMEOUT_SECONDS}s" bash -lc "$cmd" >"$log_file" 2>&1 &
    local pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        sleep 10
        if kill -0 "$pid" 2>/dev/null; then
            echo "        … $check_id sigue ejecutándose ($((SECONDS - started_at))s)"
        fi
    done
    if wait "$pid"; then
        rc=0
    else
        rc=$?
    fi
    if [ "$rc" -eq 0 ]; then
        local tail_line
        tail_line=$(tail -n 1 "$log_file" 2>/dev/null || true)
        echo -e "        ${GREEN}✓${NC} $check_id"
        if [ -n "$tail_line" ]; then
            echo "          $tail_line"
        fi
    else
        if [ "$rc" -eq 124 ]; then
            echo -e "        ${RED}✗${NC} $check_id — timeout después de ${QUALITY_TIMEOUT_SECONDS}s"
        else
            echo -e "        ${RED}✗${NC} $check_id (exit $rc)"
        fi
        tail -n 20 "$log_file" 2>/dev/null | sed 's/^/          /'
        FAIL=1
    fi
}

# ─── 1. SINTAXIS PYTHON ───────────────────────────────────────────────────────
if [ -n "$PY_FILES" ]; then
    echo "  [Sintaxis] Python..."
    SYNTAX_ERRORS=0
    while IFS= read -r f; do
        [ -f "$f" ] || continue
        if ! $VENV/python -m py_compile "$f" 2>/tmp/py_err; then
            echo -e "  ${RED}✗ Error de sintaxis en: $f${NC}"
            cat /tmp/py_err | sed 's/^/      /'
            SYNTAX_ERRORS=1
        fi
    done <<< "$PY_FILES"
    if [ $SYNTAX_ERRORS -eq 0 ]; then
        echo -e "  ${GREEN}✓ Sintaxis OK${NC}"
    else
        echo -e "\n  ${RED}✗ Corrige los errores de sintaxis antes de hacer push.${NC}\n"
        exit 1
    fi
else
    echo "  [Sintaxis] Sin archivos Python, saltando."
fi

# ─── 2. LINTING RUFF ─────────────────────────────────────────────────────────
if [ -n "$PY_FILES" ]; then
    echo "  [Lint] Ruff..."
    LINT_FILES=$(echo "$PY_FILES" | tr '\n' ' ')
    if $VENV/ruff check $LINT_FILES --quiet 2>/dev/null; then
        echo -e "  ${GREEN}✓ Linting OK${NC}"
    else
        LINT_OUTPUT=$($VENV/ruff check $LINT_FILES 2>&1 || true)
        # Solo bloquear en errores (E/F), no en warnings (W)
        ERRORS=$(echo "$LINT_OUTPUT" | grep -E '^[^ ]+:.+:(E|F)[0-9]+' || true)
        if [ -n "$ERRORS" ]; then
            echo -e "  ${RED}✗ Errores de linting (E/F):${NC}"
            echo "$ERRORS" | head -10 | sed 's/^/      /'
            FAIL=1
        else
            echo -e "  ${YELLOW}⚠ Advertencias de linting (W) — push continúa${NC}"
        fi
    fi
else
    echo "  [Lint] Sin archivos Python, saltando."
fi

# ─── 3. ALEMBIC MIGRATION CHAIN ──────────────────────────────────────────────
if [ -n "$ALEMBIC_FILES" ]; then
    echo "  [Migraciones] Cadena Alembic..."    # Validate the active canonical chain through Alembic itself. The legacy
    # alembic/versions directory is archived and is not version_location.
    cd "$REPO_ROOT"
    MIGRATION_CHECK=$($VENV/python -c "
from alembic.config import Config
from alembic.script import ScriptDirectory

config = Config('alembic.ini')
script = ScriptDirectory.from_config(config)
heads = script.get_heads()
if not heads:
    raise RuntimeError('no canonical Alembic heads found')
for revision in script.walk_revisions():
    if revision.revision is None:
        raise RuntimeError('revision without id')
print('OK:' + ','.join(sorted(heads)))
" 2>&1) || MIGRATION_CHECK="BROKEN: $MIGRATION_CHECK"
    cd - > /dev/null

    if echo "$MIGRATION_CHECK" | grep -q "^BROKEN"; then
        echo -e "  ${RED}✗ Migraciones rotas: $MIGRATION_CHECK${NC}"
        FAIL=1
    else
        echo -e "  ${GREEN}✓ Cadena de migraciones intacta${NC}"
    fi
else
    echo "  [Migraciones] Sin migraciones Alembic, saltando."
fi

# ─── 4. TESTS RÁPIDOS ────────────────────────────────────────────────────────
echo "  [Tests base] Smoke + structural..."
cd "$REPO_ROOT"
TEST_OUTPUT=$($VENV/python -m pytest tests/test_smoke.py tests/test_structural_contracts.py --override-ini="addopts=-p no:cacheprovider" -v --tb=short -q -x 2>&1) || TEST_RC=$?
cd - > /dev/null

if [ "${TEST_RC:-0}" -eq 0 ]; then
    PASS_COUNT=$(echo "$TEST_OUTPUT" | grep -oP '\d+(?= passed)' || echo "?")
    echo -e "  ${GREEN}✓ Tests OK ($PASS_COUNT passed)${NC}"
else
    echo -e "  ${RED}✗ Tests fallaron:${NC}"
    echo "$TEST_OUTPUT" | grep -E 'FAILED|ERROR|AssertionError|Error:' | head -5 | sed 's/^/      /'
    FAIL=1
fi

# ─── 5. CHECKS POR MÓDULO ────────────────────────────────────────────────────
echo "  [Checks modulares] Selector por diff..."
echo "      $QUALITY_SUMMARY"
if [ ${#QUALITY_CHECKS[@]} -eq 0 ]; then
    echo -e "      ${YELLOW}⚠ Sin checks modulares extra para este diff${NC}"
else
    echo "      Owners / razones:"
    for explanation in "${QUALITY_EXPLANATIONS[@]}"; do
        echo "        - $explanation"
    done
    for check_id in "${QUALITY_CHECKS[@]}"; do
        case "$check_id" in
            academy_quality)
                run_quality_check "$check_id" "Academy quality" \
                    "$VENV/python $REPO_ROOT/scripts/run_quality_integration.py --suite academy --test-database-url '${TEST_DATABASE_URL:-sqlite://}'"
                ;;
            cms_quality)
                if [ "$MODE" = "fast" ] && { [ -z "${E2E_EMAIL:-}" ] || [ -z "${E2E_PASSWORD:-}" ]; }; then
                    echo -e "        ${YELLOW}⚠ cms_quality omitido en modo fast: faltan E2E_EMAIL/E2E_PASSWORD${NC}"
                else
                    run_quality_check "$check_id" "CMS quality" "$VENV/python $REPO_ROOT/scripts/test_cms_quality.py"
                fi
                ;;
            crm_quality)
                run_quality_check "$check_id" "CRM quality" "$VENV/python $REPO_ROOT/scripts/test_crm_quality.py"
                ;;
            evangelism_quality)
                run_quality_check "$check_id" "Evangelism quality" "$VENV/python $REPO_ROOT/scripts/test_evangelism_quality.py"
                ;;
            messaging_quality)
                run_quality_check \
                    "$check_id" \
                    "Messaging quality" \
                    "$VENV/python $REPO_ROOT/scripts/test_messaging_quality.py"
                ;;
            agenda_quality)
                run_quality_check "$check_id" "Agenda quality" "$VENV/python $REPO_ROOT/scripts/test_agenda_quality.py"
                ;;
            frontend_build)
                # verify-build.mjs compila a un directorio desechable (.next-verify)
                # y lo elimina al terminar: valida el build SIN tocar el .next que
                # está sirviendo el proceso en producción (el build in-place rompía
                # el sitio durante el gate). Con deploy solicitado se omite para no
                # hacer doble build por push (el deploy hace build + smoke y falla
                # fuerte si algo se rompe).
                if [ "$DEPLOY_AFTER_VALIDATION" = "1" ]; then
                    echo -e "      ${YELLOW}⚠ frontend_build omitido — el deploy hará build + smoke (falla fuerte)${NC}"
                else
                    run_quality_check \
                        "$check_id" \
                        "Frontend production build" \
                        "cd $REPO_ROOT/frontend && node scripts/verify-build.mjs"
                fi
                ;;
            platform_quality)
                run_quality_check "$check_id" "Platform quality" "$VENV/python $REPO_ROOT/scripts/test_platform_quality.py"
                ;;
            projects_quality)
                run_quality_check "$check_id" "Projects quality" \
                    "$VENV/python $REPO_ROOT/scripts/run_quality_integration.py --suite projects --test-database-url '${TEST_DATABASE_URL:-sqlite://}'"
                ;;
            *)
                echo -e "      ${YELLOW}⚠ Check no reconocido: $check_id${NC}"
                ;;
        esac
    done
fi

# ─── 5.5 E2E FRONTEND MODULAR OPCIONAL ───────────────────────────────────────
if [ "$MODE" = "full" ] && [ "$RUN_FRONTEND_E2E" = "1" ]; then
    echo "  [Frontend E2E] Smokes modulares autenticados..."
    if [ -z "${E2E_AUTH_ENABLED:-}" ] || [ -z "${E2E_EMAIL:-}" ] || [ -z "${E2E_PASSWORD:-}" ] || { [ -z "${E2E_API_URL:-}" ] && [ -z "${NEXT_PUBLIC_API_URL:-}" ]; }; then
        echo -e "  ${YELLOW}⚠ Faltan variables E2E_AUTH_ENABLED/E2E_EMAIL/E2E_PASSWORD/E2E_API_URL o NEXT_PUBLIC_API_URL — se omite smoke modular autenticado${NC}"
    else
        run_quality_check \
            "frontend_e2e_modules" \
            "Frontend modular authenticated smoke" \
            "cd $REPO_ROOT/frontend && npm run test:e2e:modules"
    fi
fi

# ─── 6. VALIDACIÓN RUNTIME FULL ──────────────────────────────────────────────
if [ "$MODE" = "full" ]; then
    echo "  [Runtime full] Backend en producción..."
    HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" http://127.0.0.1:8000/api/system/health 2>/dev/null || echo "000")
    if [ "$HTTP_STATUS" = "200" ]; then
        echo -e "  ${GREEN}✓ Backend responde OK (HTTP $HTTP_STATUS)${NC}"
    else
        echo -e "  ${RED}✗ Backend NO responde (HTTP $HTTP_STATUS) — no se puede validar${NC}"
        FAIL=1
    fi

    if [ -n "$FRONTEND_FILES" ]; then
        echo "  [Runtime full] Estado de build frontend..."
        BUILD_ID="$REPO_ROOT/frontend/.next/BUILD_ID"

        if [ ! -f "$BUILD_ID" ]; then
            echo -e "  ${RED}✗ No hay build de Next.js en .next/${NC}"
            echo -e "  ${YELLOW}  Ejecuta: cd $REPO_ROOT/frontend && npm run build${NC}"
            FAIL=1
        elif [ ! -d "$REPO_ROOT/frontend/.next/server" ]; then
            echo -e "  ${RED}✗ Build incompleto — falta .next/server/${NC}"
            echo -e "  ${YELLOW}  Ejecuta: cd $REPO_ROOT/frontend && rm -rf .next && npm run build${NC}"
            FAIL=1
        else
            BUILD_AGE=$(( $(date +%s) - $(stat -c %Y "$BUILD_ID") ))
            if [ $BUILD_AGE -gt 1800 ]; then
                echo -e "  ${YELLOW}⚠ Build viejo (${BUILD_AGE}s) — considera reconstruir${NC}"
            else
                echo -e "  ${GREEN}✓ Build válido y reciente (${BUILD_AGE}s)${NC}"
            fi
        fi

        PM2_STATUS=$(pm2 jlist 2>/dev/null | python3 -c "
import sys, json
procs = json.load(sys.stdin)
for p in procs:
    if 'frontend' in p.get('name','').lower():
        print(p.get('pm2_env',{}).get('status','unknown'))
        sys.exit(0)
print('not_found')
" 2>/dev/null || echo "error")

        if [ "$PM2_STATUS" = "online" ]; then
            echo -e "  ${GREEN}✓ PM2 frontend: online${NC}"
        elif [ "$PM2_STATUS" = "errored" ] || [ "$PM2_STATUS" = "stopped" ]; then
            echo -e "  ${YELLOW}⚠ PM2 frontend: $PM2_STATUS — se reiniciará al hacer push${NC}"
        else
            echo -e "  ${YELLOW}⚠ PM2 frontend: $PM2_STATUS${NC}"
        fi
    else
        echo "  [Runtime full] Sin cambios en frontend, saltando build/PM2."
    fi

    echo "  [Runtime full] Frontend actual respondiendo..."
    FRONT_STATUS=$(curl -s -o /dev/null -w "%{http_code}" http://127.0.0.1:3000 2>/dev/null || echo "000")
    if [ "$FRONT_STATUS" = "200" ]; then
        echo -e "  ${GREEN}✓ Frontend actual: HTTP $FRONT_STATUS${NC}"
    else
        echo -e "  ${YELLOW}⚠ Frontend actual no responde (HTTP $FRONT_STATUS) — posible problema en producción${NC}"
    fi
else
    echo "  [Runtime full] Modo fast: se omiten health/build/PM2 de runtime."
fi

# ─── RESULTADO FINAL ─────────────────────────────────────────────────────────
echo ""
if [ $FAIL -eq 1 ]; then
    echo -e "  ${RED}╔══════════════════════════════════════════╗${NC}"
    echo -e "  ${RED}║  ✗ VALIDACIONES FALLIDAS — PUSH BLOQUEADO ║${NC}"
    echo -e "  ${RED}╚══════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "  ${YELLOW}Corrige los errores antes de hacer push.${NC}"
    echo ""
    exit 1
fi

echo -e "  ${GREEN}╔══════════════════════════════════════════╗${NC}"
echo -e "  ${GREEN}║  ✓ TODAS LAS VALIDACIONES PASARON        ║${NC}"
echo -e "  ${GREEN}╚══════════════════════════════════════════╝${NC}"
echo ""

mkdir -p "$VALIDATION_CACHE_DIR"
printf '%s %s %s %s %s\n' \
    "$PUSH_BRANCH" "$PUSH_LOCAL_SHA" "$BASE_REF" "$HEAD_REF" "$(date +%s)" \
    > "$VALIDATION_CACHE_FILE"

if [ "$DEPLOY_AFTER_VALIDATION" != "1" ]; then
    echo -e "  ${BLUE}ℹ Deploy omitido.${NC} Usa CCF_PRE_PUSH_DEPLOY=1 cuando quieras ejecutar release después del gate."
    echo ""
    exit 0
fi

# ─── DEPLOY ──────────────────────────────────────────────────────────────────
echo "  🚀 Desplegando cambios en producción..."
echo ""

# Migraciones Alembic
if [ -n "$ALEMBIC_FILES" ]; then
    echo "  [deploy] Aplicando migraciones Alembic..."
    cd "$REPO_ROOT"
    if PYTHONPATH="$REPO_ROOT" $VENV/alembic upgrade head > /tmp/alembic_deploy.log 2>&1; then
        echo -e "  ${GREEN}✓ Migraciones aplicadas${NC}"
    else
        echo -e "  ${YELLOW}⚠ Error en migraciones — revisa /tmp/alembic_deploy.log${NC}"
        cat /tmp/alembic_deploy.log | tail -5 | sed 's/^/      /'
    fi
    cd - > /dev/null
fi

# Backend: reiniciar si hay cambios en Python
if [ -n "$PY_FILES" ]; then
    echo "  [deploy] Reiniciando backend (PM2)..."
    if pm2 restart ccf-backend-staging > /dev/null 2>&1; then
        echo "  [deploy] Esperando health check del backend..."
        BACK_HTTP="000"
        for i in {1..30}; do
            BACK_HTTP=$(curl -s -o /dev/null -w "%{http_code}" http://127.0.0.1:8000/api/system/health 2>/dev/null || echo "000")
            if [ "$BACK_HTTP" = "200" ]; then
                break
            fi
            sleep 1
        done
        if [ "$BACK_HTTP" = "200" ]; then
            echo -e "  ${GREEN}✓ Backend reiniciado — health: HTTP $BACK_HTTP${NC}"
        else
            echo -e "  ${YELLOW}⚠ Backend no logró levantar tras 30s — health: HTTP $BACK_HTTP${NC}"
        fi
    else
        echo -e "  ${YELLOW}⚠ No se pudo reiniciar el backend — revisa PM2${NC}"
    fi
fi

# Frontend: secuencia segura build → swap → pm2 restart (evita chunks huérfanos).
# deploy_frontend.sh compila a .next-build (el .next en producción queda intacto
# durante el build), hace swap atómico al terminar y reinicia PM2 para que el
# proceso sirva el build nuevo. La comparación antigua de BUILD_ID con un grep
# del HTML de /login era frágil y podía omitir el restart.
if [ -n "$FRONTEND_FILES" ]; then
    echo "  [deploy] Frontend: build + restart seguros (scripts/deploy_frontend.sh)..."
    if bash "$REPO_ROOT/scripts/deploy_frontend.sh"; then
        echo -e "  ${GREEN}✓ Frontend desplegado — build nuevo en servicio${NC}"
    else
        echo -e "  ${RED}✗ Deploy del frontend falló — revisa los logs${NC}"
        exit 1
    fi
fi

echo ""
